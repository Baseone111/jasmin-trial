# Optional overrides. Defaults are local lab credentials, NEVER production secrets.
DEMO_API_KEY=local-demo-key
CALLBACK_SECRET=local-callback-secret
JASMIN_USERNAME=demo-app
JASMIN_PASSWORD=local-sms-only
JCLI_PASSWORD=local-admin-only
# Official image used in the Jasmin quickstart. Pin a verified digest for a stable lab.
JASMIN_IMAGE=jookies/jasmin:latest
